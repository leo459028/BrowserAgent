APP_NAME=browser-agent
APP_VERSION=1.1.0
APP_ENV=production
APP_LOG_LEVEL=INFO
APP_SECRET_KEY=replace-with-production-secret
AUTH_ENABLED=true
AUTH_MODE=jwks
AUTH_JWKS_URL=https://idp.example.test/.well-known/jwks.json
AUTH_OIDC_ISSUER_URL=
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_JWKS_REQUEST_TIMEOUT_SECONDS=5
AUTH_LOCAL_TOKENS_ENABLED=false
AUTH_JWT_ISSUER=https://idp.example.test
AUTH_JWT_AUDIENCE=browser-agent-api

DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent
REDIS_URL=redis://redis:6379/0
RELIABILITY_STORE=redis
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
ARTIFACT_BACKEND=s3
ARTIFACT_BASE_PATH=/data/artifacts
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=replace-with-minio-secret
MINIO_BUCKET=browser-agent

ALLOWLIST_DOMAINS=example.com,example.org
TASK_CREATE_RATE_LIMIT_PER_MINUTE=60
IDEMPOTENCY_TTL_SECONDS=86400
TASK_LOCK_TTL_SECONDS=300
MAX_TASK_RETRIES=2
TASK_TIMEOUT_SECONDS=120
BROWSER_HEADLESS=true
WORKER_SERVICE_ID=worker-prod
DLQ_TOPIC=agent.tasks.dlq

OTEL_ENABLED=false
OTEL_SERVICE_NAME=browser-agent
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_RESOURCE_ATTRIBUTES=service.namespace=browser-agent,deployment.environment=production
OTEL_PROPAGATORS=tracecontext,baggage
