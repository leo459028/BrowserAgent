# ==============================================================================
# BrowserAgent - Environment Configuration Template (.env.example)
# Version: 1.4.2 (Enterprise AI Agent Safety & HITL Browser Automation)
# ==============================================================================

# --- Core Application Settings ---
APP_NAME=browser-agent
APP_VERSION=1.4.2
APP_ENV=local                    # Options: local | staging | production
APP_LOG_LEVEL=INFO               # Options: DEBUG | INFO | WARNING | ERROR
APP_SECRET_KEY=change-me-to-a-secure-random-32-byte-secret

# --- Authentication & Zero-Trust Access Control ---
AUTH_ENABLED=true
AUTH_MODE=local                  # Options: local (HS256 tokens) | jwks (RS256 validation)
AUTH_LOCAL_TOKENS_ENABLED=true   # Set to false in production environments
AUTH_JWT_ISSUER=browser-agent-local
AUTH_JWT_AUDIENCE=browser-agent-api
AUTH_JWKS_URL=                   # E.g., https://auth.example.com/.well-known/jwks.json
AUTH_OIDC_ISSUER_URL=             # E.g., https://auth.example.com
AUTH_JWKS_CACHE_TTL_SECONDS=300
AUTH_JWKS_REQUEST_TIMEOUT_SECONDS=5
AUTH_TOKEN_TTL_SECONDS=3600

# --- Enterprise OIDC SSO (Authorization Code Flow with PKCE) ---
AUTH_OIDC_CLIENT_ID=browser-agent-client
AUTH_OIDC_CLIENT_SECRET=change-me-client-secret
AUTH_OIDC_REDIRECT_URI=http://localhost:8000/v1/auth/oidc/callback
AUTH_OIDC_AUTHORIZATION_ENDPOINT=
AUTH_OIDC_TOKEN_ENDPOINT=
AUTH_OIDC_USERINFO_ENDPOINT=

# --- Session Vault & KMS Envelope Encryption ---
# Supported providers: "local" (AES-256-GCM), "aws" (AWS KMS), "vault" (HashiCorp Vault)
KMS_PROVIDER=local
KMS_MASTER_KEY=01234567890123456789012345678901  # 32-byte key for local AES-256-GCM
KMS_KEY_ID=local-kek-v1
KMS_REGION=us-east-1
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=

# --- Infrastructure Backends ---
DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent
REDIS_URL=redis://redis:6379/0
RELIABILITY_STORE=redis          # Options: redis | memory
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
DLQ_TOPIC=agent.tasks.dlq

# --- Artifact & Session Storage ---
ARTIFACT_BACKEND=s3              # Options: local | s3
ARTIFACT_BASE_PATH=/data/artifacts
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio12345
MINIO_BUCKET=browser-agent

# --- Multi-Priority Queuing & Worker Pools ---
MULTI_PRIORITY_ENABLED=true
QUEUE_HIGH_TOPIC=agent.tasks.high
QUEUE_DEFAULT_TOPIC=agent.tasks.queued
QUEUE_BATCH_TOPIC=agent.tasks.batch
WORKER_POOL=default

# --- Human-in-the-Loop (HITL) Bidirectional Remote Takeover ---
REMOTE_TAKEOVER_ENABLED=true
REMOTE_TAKEOVER_TIMEOUT_SECONDS=300

# --- Multi-Engine Cross-Browser Grid ---
DEFAULT_BROWSER_ENGINE=chromium  # Options: chromium | firefox | webkit

# --- Zero-Trust Dynamic DLP (Data Loss Prevention) ---
DLP_ENABLED=true
DLP_MASK_PASSWORDS=true          # Injects dynamic CSS blur masks onto password fields
DLP_REDACT_TOKENS=true           # Redacts API keys, JWTs, and bearer tokens from artifacts & metadata

# --- Multi-Cluster Scheduling Federation ---
FEDERATION_ENABLED=true
FEDERATION_NODE_ID=node-local-1
FEDERATION_REGION=local-dev
FEDERATION_HEARTBEAT_INTERVAL_SECONDS=10
FEDERATION_LEASE_TTL_SECONDS=30

# --- Heuristic Self-Healing & Live Telemetry ---
LIVE_BROADCAST_ENABLED=true
SELF_HEALING_ENABLED=true
SELF_HEALING_THRESHOLD=0.75
WORKER_RECORD_VIDEO_DEFAULT=true

# --- Task Execution & Safety Guardrails ---
ALLOWLIST_DOMAINS=example.com,example.org
TASK_CREATE_RATE_LIMIT_PER_MINUTE=60
IDEMPOTENCY_TTL_SECONDS=86400
TASK_LOCK_TTL_SECONDS=300
MAX_TASK_RETRIES=2
TASK_TIMEOUT_SECONDS=120
BROWSER_HEADLESS=true
WORKER_SERVICE_ID=worker-local
SCHEDULER_ENABLED=true

# --- Distributed Tracing & OpenTelemetry OTLP ---
OTEL_ENABLED=false
OTEL_SERVICE_NAME=browser-agent
OTEL_EXPORTER_OTLP_ENDPOINT=     # E.g., http://otel-collector:4318/v1/traces
OTEL_RESOURCE_ATTRIBUTES=service.namespace=browser-agent,deployment.environment=local
OTEL_PROPAGATORS=tracecontext,baggage

# --- Production Alerting Center ---
ALERT_WEBHOOK_URL=               # Slack / Discord / PagerDuty incoming webhook URL
ALERT_DLQ_THRESHOLD=5
ALERT_AUTH_FAILURES_THRESHOLD=10
ALERT_QUARANTINE_THRESHOLD=3
ALERT_WEBHOOK_TIMEOUT_SECONDS=3.0
